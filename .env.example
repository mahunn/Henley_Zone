NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_DASHBOARD_USERNAME=
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=

# Meta (Facebook) Tracking — Browser Pixel & Server Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side Conversions API (CAPI) Access Token (generated in Events Manager -> Settings)
META_CONVERSIONS_API_ACCESS_TOKEN=
# Optional: Test Event Code from Meta Events Manager "Test Events" tab (remove in production)
# META_CONVERSIONS_API_TEST_EVENT_CODE=

# Optional easy image upload in production (no Supabase Storage needed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Force local uploads to Hostnin/local disk (set to 'true' to keep Supabase free tier egress 0)
UPLOAD_LOCAL=

# Google Sheet Webhook Sync (optional)
GOOGLE_SHEET_WEBHOOK_URL=

# Pathao Courier Merchant API
# Sandbox: https://courier-api-sandbox.pathao.com
# Production: https://api-hermes.pathao.com
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_GRANT_TYPE=password
PATHAO_STORE_ID=
